<% currentView = 'videos'; %>

<div class="flex-between">
    <h2 style="font-size:20px;font-weight:700;">Edit Video</h2>
    <a href="/admin/videos" class="btn btn-secondary">Back to Videos</a>
</div>

<div class="card">
    <form action="/admin/videos/<%= encodeURIComponent(video.filename) %>/edit" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" value="<%= video.title || '' %>" required>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="category">Category</label>
                <select id="category" name="category">
                    <option value="Sermons" <%= video.category === 'Sermons' ? 'selected' : '' %>>Sermons</option>
                    <option value="Events" <%= video.category === 'Events' ? 'selected' : '' %>>Events</option>
                </select>
            </div>
            <div class="form-group">
                <label for="releaseDate">Release Date</label>
                <input type="date" id="releaseDate" name="releaseDate" value="<%= video.releaseDate || '' %>" required>
            </div>
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" rows="3"><%- video.description || '' %></textarea>
        </div>

        <div style="display:flex;gap:12px;">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="/admin/videos" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

<% if (hasThumbnail) { %>
<div class="card">
    <h3>Current Thumbnail</h3>
    <img src="/output/thumbnails/<%= encodeURIComponent(video.filename) %>.jpg" alt="Thumbnail" style="max-width:320px;border-radius:var(--radius);margin-bottom:12px;">
    <form action="/admin/videos/<%= encodeURIComponent(video.filename) %>/thumbnail" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
            <label for="thumbnail">Replace Thumbnail</label>
            <input type="file" id="thumbnail" name="thumbnail" accept="image/jpeg,image/png">
        </div>
        <button type="submit" class="btn btn-secondary btn-sm">Upload New Thumbnail</button>
    </form>
</div>
<% } else { %>
<div class="card">
    <h3>Upload Custom Thumbnail</h3>
    <form action="/admin/videos/<%= encodeURIComponent(video.filename) %>/thumbnail" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
            <label for="thumbnail">Thumbnail Image (.jpg, .png)</label>
            <input type="file" id="thumbnail" name="thumbnail" accept="image/jpeg,image/png">
        </div>
        <button type="submit" class="btn btn-secondary btn-sm">Upload Thumbnail</button>
    </form>
</div>
<% } %>
