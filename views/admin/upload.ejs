<% currentView = 'upload'; %>

<div class="flex-between">
    <h2 style="font-size:20px;font-weight:700;">Upload Video</h2>
    <a href="/admin/videos" class="btn btn-secondary">Back to Videos</a>
</div>

<div class="card">
    <form action="/admin/videos" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
            <label for="video-file">Video File</label>
            <input type="file" id="video-file" name="video" accept=".mp4,.mov,.avi,.mkv" required style="padding:8px;">
            <div class="text-muted mt-2">Supported formats: <%= typeof uploadFormats !== "undefined" && uploadFormats.videoHuman ? uploadFormats.videoHuman : "" %>.<% if (typeof uploadLimits !== "undefined" && uploadLimits.videoMaxHuman) { %> Max size: <%= uploadLimits.videoMaxHuman %>.<% } %></div>
        </div>

        <div class="form-group">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" placeholder="Video title" required>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="category">Category</label>
                <select id="category" name="category">
                    <option value="Sermons">Sermons</option>
                    <option value="Events">Events</option>
                </select>
            </div>
            <div class="form-group">
                <label for="releaseDate">Release Date</label>
                <input type="date" id="releaseDate" name="releaseDate" value="<%= new Date().toISOString().split('T')[0] %>" required>
            </div>
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" rows="3" placeholder="Optional description"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Upload Video</button>
    </form>
</div>

<script>
    // Auto-populate title and release date from selected video filename
    (function () {
        const fileInput = document.getElementById('video-file');
        const titleInput = document.getElementById('title');
        const dateInput = document.getElementById('releaseDate');

        // Known month names (case-insensitive matching)
        const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
        const monthAbbr = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

        function parseTitleAndDate(filename) {
            // Strip extension
            var base = filename.replace(/\.[^.]+$/, '');

            // Try to extract date patterns: "Title Month DD, YYYY" or "Title - Month DD, YYYY"
            var releaseDate = '';
            var title = base;

            // Match: "Sermon - January 15, 2025" or "Sermon January 15 2025"
            // Group 1 = title prefix (optional dash separator stripped), Group 2 = month, Group 3 = day, Group 4 = year
            var datePattern = /^(.+?)(?:\s*[-–\u2014]\s*)?(January|February|March|April|May|June|July|August|September|October|November|December|Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[\s,]+(\d{1,2})[,\.]?\s+(\d{4})\s*$/i;
            var match = base.match(datePattern);

            if (match) {
                var monthStr = match[2];
                var day = match[3].padStart(2, '0');
                var year = match[4];

                // Check if captured month is a known month name
                var monthIdx = months.findIndex(function(m) { return monthStr.toLowerCase() === m.toLowerCase(); });
                if (monthIdx === -1) {
                    monthIdx = monthAbbr.findIndex(function(m) { return monthStr.toLowerCase() === m.toLowerCase(); });
                }

                if (monthIdx !== -1) {
                    // Strip trailing dash/separator from title
                    title = match[1].replace(/[-–\u2014]\s*$/, '').trim();
                    releaseDate = year + '-' + String(monthIdx + 1).padStart(2, '0') + '-' + day;
                }
            }

            // If no date extracted, title = cleaned filename (replace underscores/hyphens with spaces, title case)
            if (!releaseDate) {
                title = base.replace(/[_-]/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); });
            }

            return { title: title, releaseDate: releaseDate };
        }

        fileInput.addEventListener('change', function () {
            if (this.files && this.files[0]) {
                var parsed = parseTitleAndDate(this.files[0].name);
                titleInput.value = parsed.title;
                if (parsed.releaseDate) {
                    dateInput.value = parsed.releaseDate;
                }
            }
        });
    })();
</script>
